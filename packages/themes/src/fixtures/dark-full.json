{
  // A hand-written dark theme with most keys set, in the style of popular dark themes.
  "name": "Fixture Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#282a36",
    "editor.foreground": "#f8f8f2",
    "foreground": "#f8f8f2",
    "sideBar.background": "#21222c",
    "input.background": "#343746",
    "menu.background": "#343746",
    "titleBar.activeBackground": "#191a21",
    "statusBar.background": "#191a21",
    "statusBar.foreground": "#f8f8f2",
    "panel.border": "#bd93f950",
    "input.border": "#191a21",
    "descriptionForeground": "#a0a4b8",
    "button.background": "#bd93f9",
    "button.foreground": "#282a36",
    "list.hoverBackground": "#44475a75",
    "list.activeSelectionBackground": "#44475a",
    "editor.selectionBackground": "#44475a",
    "focusBorder": "#6272a4",
    "errorForeground": "#ff5555",
    "editorWarning.foreground": "#ffb86c",
    "terminal.ansiRed": "#ff5555",
    "terminal.ansiGreen": "#50fa7b",
    "terminal.background": "#282a36",
