{
  "name": "jig",
  "private": true,
  "version": "0.17.1",
  "description": "Jig — a personal agentic workbench around Claude Code that builds its own tools.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "relay/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @jig/desktop",
    "build": "npm run build --workspace @jig/desktop",
    "start": "npm run start --workspace @jig/desktop",
    "typecheck": "node scripts/verify.ts --typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.ts",
    "check:addon-imports": "node scripts/check-addon-imports.ts",
    "codex:protocol": "node scripts/codex-protocol.ts",
    "check:decisions": "node scripts/decision.ts --check",
    "decision": "node scripts/decision.ts",
    "check": "node scripts/verify.ts --full && npm run test",
    "verify": "node scripts/verify.ts",
    "e2e": "node scripts/e2e.ts",
    "e2e:changed": "node scripts/e2e-changed.ts",
    "release": "node scripts/release.ts",
    "relay:build": "npm run build --workspace @jig/teams-relay",
    "teams:check": "node scripts/teams-check.ts",
    "dist": "npm run build && npm run dist --workspace @jig/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
