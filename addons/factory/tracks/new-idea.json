{
  "id": "new-idea",
  "title": "New idea",
  "description": "An idea for a product or a module: the interview, a polished demo, then the whole pack",
  "caps": { "revisionsPerGate": 3, "retriesPerStage": 1 },
  "stages": [
    { "id": "S1", "recipe": "interview", "title": "Interview", "interactive": true },
    { "id": "S2", "recipe": "scout", "title": "Scout", "after": ["S1"] },
    { "gate": "G0", "after": ["S2"] },
    { "id": "S3", "recipe": "plan", "title": "Plan", "person": true, "after": ["G0"] },
    {
      "id": "S4",
      "recipe": "kit-extract",
      "title": "Product kit",
      "after": ["S3"],
      "when": "product.exists"
    },
    {
      "id": "S4b",
      "recipe": "directions",
      "title": "Directions",
      "after": ["S3"],
      "when": "!product.exists"
    },
    { "gate": "GD", "after": ["S4b"] },
    { "id": "S5", "recipe": "demo-{level}", "title": "Build the demo", "after": ["S4|GD"] },
    {
      "id": "S6",
      "recipe": "critique",
      "title": "Quality gate",
      "after": ["S5"],
      "loop": { "back": "S5", "until": "quality.pass", "max": 3 }
    },
    { "gate": "G1", "after": ["S6"], "changes": "S5" },
    { "fanout": "S7", "title": "Pack", "after": ["G1"], "outputs": "plan.outputs" },
    {
      "gate": "G2",
      "after": ["S7:spec", "S7:stories", "S7:tests", "S7:release-notes", "S7:glossary"]
    },
    {
      "gate": "G4",
      "after": [
        "S7:pitch",
        "S7:deck",
        "S7:deck-images",
        "S7:one-pager",
        "S7:one-pager-images",
        "S7:objections",
        "S7:letter",
        "S7:course-sales",
        "S7:course-customer"
      ]
    },
    {
      "gate": "G4m",
      "after": [
        "S7:marketing",
        "S7:article",
        "S7:linkedin",
        "S7:newsletter",
        "S7:marketing-images",
        "S7:teaser"
      ]
    },
    { "id": "S8", "recipe": "build", "title": "Build", "after": ["G2"], "when": "build.requested" },
    { "gate": "G3", "after": ["S8"] },
    { "gate": "G5", "after": ["G4|G4m"] }
  ]
}
