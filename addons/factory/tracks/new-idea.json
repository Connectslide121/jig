{
  "id": "new-idea",
  "title": "New idea",
  "caps": { "revisionsPerGate": 3, "retriesPerStage": 1 },
  "stages": [
    { "id": "S1", "recipe": "interview", "title": "Interview", "interactive": true },
    { "id": "S2", "recipe": "scout", "title": "Scout", "after": ["S1"] },
    { "gate": "G0", "after": ["S2"] },
    {
      "id": "S4",
      "recipe": "kit-extract",
      "title": "Product kit",
      "after": ["G0"],
      "when": "product.exists"
    },
    {
      "id": "S4b",
      "recipe": "directions",
      "title": "Directions",
      "after": ["G0"],
      "when": "!product.exists"
    },
    { "gate": "GD", "after": ["S4b"] },
    { "id": "S5", "recipe": "demo-{level}", "title": "Build the demo", "after": ["S4|GD"] },
    {
      "id": "S6",
      "recipe": "critique",
      "title": "Quality gate",
      "after": ["S5"],
      "loop": { "back": "S5", "until": "quality.pass", "max": 3 }
    },
    { "gate": "G1", "after": ["S6"], "changes": "S5" },
    { "fanout": "S7", "title": "Pack", "after": ["G1"], "outputs": "plan.outputs" },
    { "gate": "G2", "after": ["S7:spec", "S7:stories", "S7:tests"] },
    { "gate": "G4", "after": ["S7:pitch", "S7:deck", "S7:course-sales"] },
    { "gate": "G4m", "after": ["S7:marketing"] },
    { "id": "S8", "recipe": "build", "title": "Build", "after": ["G2"], "when": "build.requested" },
    { "gate": "G3", "after": ["S8"] },
    { "gate": "G5", "after": ["G4|G4m"] }
  ]
}
