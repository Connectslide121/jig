{
  "$schema": "../../packages/sdk/addon.schema.json",
  "id": "pipelines",
  "name": "Pipelines",
  "description": "Azure DevOps pipelines of the repositories you have checked out, like the pipelines plugin: newest run and its stages, a Run form with the branch and the YAML's parameters, notifications when a run you started finishes; more pipelines from every organisation.",
  "version": "1.0.0",
  "icon": "rocket",
  "permissions": ["exec:az", "exec:git", "fs:read"],
  "contributes": {
    "views": [
      {
        "id": "pipelines",
        "title": "Pipelines",
        "icon": "rocket",
        "region": "right",
        "component": "PipelinesView"
      }
    ],
    "actions": [
      {
        "id": "show",
        "title": "Show pipelines",
        "group": "Pipelines",
        "icon": "rocket",
        "run": "showPipelines"
      },
      {
        "id": "run",
        "title": "Run a pipeline…",
        "group": "Pipelines",
        "icon": "play",
        "run": "runPipelineAction"
      }
    ],
    "watchers": [
      {
        "id": "runs",
        "every": "1m",
        "run": "checkTrackedRuns"
      }
    ],
    "settings": {
      "title": "Pipelines",
      "component": "PipelinesSettings"
    }
  }
}
