{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/format-after-tool.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
